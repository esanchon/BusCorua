<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ubicación aproximada: solo para poner arriba la tarjeta de la ruta que sale de donde estás -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".presentation.BusApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_bus_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault"
        android:largeHeap="true">
        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <!--
               Set to true if your app is Standalone, that is, it does not require the handheld
               app to run.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".presentation.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.ui.RouteDetailActivity"
            android:exported="false"
            android:label="Próximos buses"
            android:theme="@android:style/Theme.DeviceDefault" />

        <activity
            android:name=".presentation.ui.SettingsActivity"
            android:exported="false"
            android:label="Configuración"
            android:theme="@android:style/Theme.DeviceDefault" />

        <activity
            android:name=".presentation.ui.StopPickerActivity"
            android:exported="false"
            android:label="Añadir parada"
            android:theme="@android:style/Theme.DeviceDefault" />

        <activity
            android:name=".presentation.ui.StopPadActivity"
            android:exported="false"
            android:label="Parada"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Complicaciones de la esfera: aparecen al personalizar la esfera como "Bus al trabajo" / "Bus a casa" -->
        <service
            android:name=".presentation.complication.WorkComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_work"
            android:label="Bus al trabajo"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <!-- Mínimo que permite Wear OS; entre medias la esfera descuenta los minutos sola -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <service
            android:name=".presentation.complication.HomeComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_home"
            android:label="Bus a casa"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <!-- Mínimo que permite Wear OS; entre medias la esfera descuenta los minutos sola -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <!-- Una sola complicación que muestra la ruta que sale de donde estás, con su icono -->
        <service
            android:name=".presentation.complication.NearestComplicationService"
            android:exported="true"
            android:icon="@drawable/ic_complication_work"
            android:label="Bus según ubicación"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>
    </application>

</manifest>